rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Trips Collection: stored under users/{userId}/trips/{tripId}
    // Only the authenticated owner can read, create, update, or delete their trips
    match /users/{userId}/trips/{tripId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Memories Collection: stored under users/{userId}/memories/{memoryId}
    // Private to the authenticated user - only the owner can read, create, update, or delete
    match /users/{userId}/memories/{memoryId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Legacy/Global Memories fallback (scoped strictly to owner)
    match /memories/{memoryId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Contact Form Submissions
    // Public visitors can submit contact inquiries
    // Inquiries are write-only and cannot be read, updated, or deleted by general clients
    match /contactMessages/{messageId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Default deny-all for any other path
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
